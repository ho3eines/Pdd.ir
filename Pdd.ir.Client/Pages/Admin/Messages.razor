@page "/admin/messages"
@attribute [AuthorizeRole("admin")]
@implements IDisposable
@inject ICommunicationService Comm
@inject ITranslateService T
@inject IModalService Modal
@inject IAlertService Alert
@inject IFileUploadService FileUpload

<PageTitle>@T.Text("contact_management") | PDD</PageTitle>

<div class="page-enter">
    @if (UnreadCount > 0)
    {
        <div style="background:linear-gradient(135deg,rgba(13,110,253,0.1),rgba(248,28,229,0.1));border:1px solid rgba(13,110,253,0.2);border-radius:12px;padding:16px 20px;margin-bottom:20px;display:flex;align-items:center;gap:12px;">
            <div style="width:40px;height:40px;border-radius:50%;background:#0D6EFD;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:16px;">@UnreadCount</div>
            <div>
                <div style="font-weight:600;font-size:14px;">@T.Text("unread_messages")</div>
                <div style="font-size:12px;color:var(--text-secondary);">@T.Text("unread_messages_desc")</div>
            </div>
        </div>
    }

    <PddTable TItem="ContactDto"
              Items="@Items"
              Title="@T.Text("contact_management")"
              Subtitle="@T.Text("contact_subtitle")"
              IsLoading="@IsLoading"
              PageSize="10"
              CanInsert="false"
              CanEdit="false"
              CanDelete="true"
              ShowSearch="true"
              Columns="@GetColumns()"
              SearchFilter="@Search"
              OnDelete="Delete"
              DeleteMessageSelector="@(x => T.Text("are_you_sure_delete"))">
        <RowActions>
            @if (!context.IsRead)
            {
                <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkAsRead(context)" title="@T.Text("mark_as_read")">
                    <i class="bi bi-envelope-open"></i>
                </button>
            }
            <button class="btn btn-sm btn-outline-info" @onclick="() => ShowDetail(context)" title="@T.Text("view_detail")">
                <i class="bi bi-eye"></i>
            </button>
        </RowActions>
    </PddTable>
</div>

@code {
    List<ContactDto> Items = new();
    bool IsLoading = true;
    int UnreadCount = 0;

    protected override async Task OnInitializedAsync()
    {
        T.OnLanguageChanged += Refresh;
        await LoadData();
    }

    async Task LoadData()
    {
        IsLoading = true;
        var response = await Comm.GetAsync<ContactListResponse>("api/contact");
        if (response?.success == true && response.data != null)
            Items = response.data;
        else
            Items = new();

        UnreadCount = Items.Count(x => !x.IsRead);
        IsLoading = false;
        StateHasChanged();
    }

    List<PddTableColumn<ContactDto>> GetColumns() => new()
    {
        new() { Title = "#", GetValue = x => x.Id.ToString() },
        new() { Title = T.Text("name_fa"), Template = c => builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "style", "display:flex;align-items:center;gap:8px;");
            if (!c.IsRead)
            {
                builder.OpenElement(2, "span");
                builder.AddAttribute(3, "style", "width:8px;height:8px;border-radius:50%;background:#0D6EFD;flex-shrink:0;");
                builder.CloseElement();
            }
            builder.OpenElement(4, "span");
            builder.AddAttribute(5, "style", c.IsRead ? "" : "font-weight:600;");
            builder.AddContent(6, c.Name);
            builder.CloseElement();
            builder.CloseElement();
        }},
        new() { Title = T.Text("email"), GetValue = x => x.Email },
        new() { Title = T.Text("phone"), GetValue = x => x.Phone },
        new() { Title = T.Text("subject"), Template = c => builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "style", c.IsRead ? "" : "font-weight:600;");
            builder.AddContent(2, string.IsNullOrEmpty(c.Subject) ? "-" : (c.Subject.Length > 30 ? c.Subject[..30] + "..." : c.Subject));
            builder.CloseElement();
        }},
        new() { Title = T.Text("message"), Template = c => builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "style", "font-size:12px;color:var(--text-secondary);");
            var msg = c.Message?.Length > 50 ? c.Message[..50] + "..." : c.Message;
            builder.AddContent(2, msg ?? "-");
            builder.CloseElement();
        }},
        new() { Title = T.Text("date"), Template = c => builder =>
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "style", "font-size:12px;white-space:nowrap;");
            builder.AddContent(2, c.CreatedAt.ToString("yyyy/MM/dd HH:mm"));
            builder.CloseElement();
        }}
    };

    bool Search(ContactDto x, string q) =>
        (x.Name ?? "").ToLower().Contains(q) ||
        (x.Email ?? "").ToLower().Contains(q) ||
        (x.Subject ?? "").ToLower().Contains(q) ||
        (x.Message ?? "").ToLower().Contains(q);

    async Task MarkAsRead(ContactDto item)
    {
        await Comm.PutAsync<object>($"api/contact/{item.Id}/read", null);
        item.IsRead = true;
        UnreadCount = Items.Count(x => !x.IsRead);
        StateHasChanged();
    }

    async Task ShowDetail(ContactDto item)
    {
        if (!item.IsRead)
            await MarkAsRead(item);

        await Modal.Show<ContactMessageDialog>(T.Text("message_detail"), new Dictionary<string, object> { { "Message", item } });
    }

    async Task Delete(ContactDto item)
    {
        try
        {
            var result = await Comm.DeleteAsync($"api/contact/{item.Id}");
            if (result)
            {
                await Alert.ShowSuccessAsync(T.Text("success"), T.Text("deleted_successfully"));
                await LoadData();
            }
            else await Alert.ShowErrorAsync(T.Text("error"), T.Text("operation_failed"));
        }
        catch { await Alert.ShowErrorAsync(T.Text("error"), T.Text("operation_failed")); }
    }

    void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => T.OnLanguageChanged -= Refresh;

    public class ContactListResponse
    {
        public bool success { get; set; }
        public List<ContactDto>? data { get; set; }
    }
}
