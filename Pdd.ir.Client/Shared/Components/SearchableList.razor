@using Microsoft.AspNetCore.Components.Web
@using Pdd.ir.Client.Services
@typeparam TItem
@typeparam TValue
@inject IModalService Modal

<div class="sl-wrapper">
    <input type="text"
           class="form-control"
           value="@displayText"
           @onclick="OpenModal"
           @onfocus="OpenModal"
           placeholder="@Placeholder"
           readonly
           style="cursor:pointer;" />
</div>

@code {
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public Func<TItem, string> TextSelector { get; set; } = item => item?.ToString() ?? string.Empty;
    [Parameter] public Func<TItem, TValue> ValueSelector { get; set; } = null!;
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue> ValueChanged { get; set; }
    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem> SelectedItemChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "جستجو...";

    private string displayText = string.Empty;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        UpdateDisplayText();
    }

    private void UpdateDisplayText()
    {
        TItem? itemToSync = default;
        if (Value is not null && ValueSelector is not null)
            itemToSync = Items.FirstOrDefault(item => EqualityComparer<TValue>.Default.Equals(ValueSelector(item), Value));
        else if (SelectedItem is not null)
            itemToSync = SelectedItem;

        displayText = itemToSync is not null ? TextSelector(itemToSync) : string.Empty;
    }

    private async Task OpenModal()
    {
        var currentValue = default(TItem);
        if (Value is not null && ValueSelector is not null)
            currentValue = Items.FirstOrDefault(item => EqualityComparer<TValue>.Default.Equals(ValueSelector(item), Value));
        else if (SelectedItem is not null)
            currentValue = SelectedItem;

        var key = SearchableListRegistry.Register(
            Items,
            item => TextSelector((TItem)item),
            currentValue
        );

        var result = await Modal.ShowAsync<string, SearchableListModal>(
            Placeholder,
            new Dictionary<string, object> { { "RegistryKey", key } },
            modalSize: "modal-sm"
        );

        if (!string.IsNullOrEmpty(result))
        {
            var matchedItem = Items.FirstOrDefault(item => TextSelector(item) == result);
            if (matchedItem is not null)
            {
                SelectedItem = matchedItem;
                displayText = TextSelector(matchedItem);

                if (SelectedItemChanged.HasDelegate)
                    await SelectedItemChanged.InvokeAsync(SelectedItem);

                if (ValueChanged.HasDelegate && ValueSelector is not null)
                    await ValueChanged.InvokeAsync(ValueSelector(matchedItem));
            }
        }
    }
}
