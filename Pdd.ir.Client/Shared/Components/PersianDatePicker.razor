@using Pdd.ir.Client.Helpers
@using Pdd.ir.Client.Services
@inject IModalService Modal

<div class="position-relative">
    <input type="text"
           class="@CssClass"
           value="@inputText"
           @onclick="OpenCalendar"
           @onfocus="OpenCalendar"
           placeholder="@Placeholder"
           readonly
           style="cursor:pointer;" />
    <i class="bi bi-calendar3 position-absolute" style="left:12px;top:50%;transform:translateY(-50%);color:var(--text-secondary,#9CA3AF);pointer-events:none;font-size:0.875rem;"></i>
</div>

@code {
    [Parameter] public long? Value { get; set; }
    [Parameter] public EventCallback<long?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ";
    [Parameter] public string CssClass { get; set; } = "form-control";

    private string inputText = string.Empty;

    protected override void OnParametersSet()
    {
        UpdateInputText();
    }

    private void UpdateInputText()
    {
        inputText = Value.HasValue ? DateHelper.ToShamsi(Value.Value) : string.Empty;
    }

    private async Task OpenCalendar()
    {
        var result = await Modal.ShowAsync<long?, PersianCalendarModal>(
            "انتخاب تاریخ",
            new Dictionary<string, object> { { "InitialValue", Value } },
            modalSize: "modal-sm"
        );

        if (result.HasValue)
        {
            Value = result.Value;
            UpdateInputText();
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
