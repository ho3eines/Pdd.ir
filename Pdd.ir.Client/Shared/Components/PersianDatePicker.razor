@using Pdd.ir.Client.Helpers
@using Pdd.ir.Client.Services
@inject IModalService Modal

<div class="pdp-wrapper" @onclick="OpenCalendar">
    <input type="text"
           class="form-control pdp-input"
           value="@inputText"
           placeholder="@Placeholder"
           readonly
           style="cursor:pointer;padding-left:36px;" />
    <i class="bi bi-calendar3 pdp-icon"></i>
</div>

<style>
    .pdp-wrapper { position: relative; width: 100%; cursor: pointer; }
    .pdp-icon {
        position: absolute; left: 12px; top: 50%; transform: translateY(-50%);
        color: var(--text-secondary, #9CA3AF); pointer-events: none;
        font-size: 0.9rem; transition: color 0.2s ease;
    }
    .pdp-wrapper:hover .pdp-icon { color: #0d6efd; }
</style>

@code {
    [Parameter] public long? Value { get; set; }
    [Parameter] public EventCallback<long?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب تاریخ";
    [Parameter] public string CssClass { get; set; } = "";

    private string inputText = string.Empty;

    protected override void OnParametersSet()
    {
        UpdateInputText();
    }

    private void UpdateInputText()
    {
        inputText = Value.HasValue ? DateHelper.ToShamsi(Value.Value) : string.Empty;
    }

    private async Task OpenCalendar()
    {
        var result = await Modal.ShowAsync<long?, PersianCalendarModal>(
            "انتخاب تاریخ",
            new Dictionary<string, object> { { "InitialValue", Value } },
            modalSize: "modal-sm"
        );

        if (result.HasValue)
        {
            Value = result.Value;
            UpdateInputText();
            await ValueChanged.InvokeAsync(Value);
        }
    }
}
