<div @ref="_elementRef" class="animated-section anim-@AnimationType">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string AnimationType { get; set; } = "fade-up";
    [Parameter] public double Delay { get; set; } = 0;

    private ElementReference _elementRef;
}
